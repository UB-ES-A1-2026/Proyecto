PORT=3000
DATABASE_URL=postgresql://rentit:rentit@localhost:5432/rentit
DIRECT_URL=postgresql://rentit:rentit@localhost:5432/rentit
CORS_ORIGINS=http://localhost:5173
# Opcional: URLs de preview de Vercel (ADR 0001 §3). Anclada y con el nombre del proyecto y del equipo, p. ej.:
# CORS_PREVIEW_PATTERN=^https://rentit-[a-z0-9-]+-<equipo>\.vercel\.app$
BCRYPT_ROUNDS=10
# Opcional: bucket de las fotos de los objetos (ADR 0002, #106). Sin S3_BUCKET la API arranca igual y
# la subida de fotos responde 503. En local se puede probar con el S3 de spikes/sp03-imagenes:
# S3_BUCKET=rentit-fotos
# S3_REGION=us-east-1
# S3_ENDPOINT=http://127.0.0.1:9090
# S3_ACCESS_KEY_ID=local
# S3_SECRET_ACCESS_KEY=local
# S3_FORCE_PATH_STYLE=true
