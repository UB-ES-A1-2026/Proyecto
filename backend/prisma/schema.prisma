generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Tablas y columnas en español según docs/modelo-datos.md (#98); modelos y campos en inglés.

enum UserRole {
  user  @map("usuario")
  admin

  @@map("rol_usuario")
}

enum UserStatus {
  active  @map("activo")
  blocked @map("bloqueado")

  @@map("estado_usuario")
}

model User {
  id                        String             @id @default(uuid()) @db.Uuid
  username                  String             @unique @map("nombre_usuario") @db.VarChar(30)
  email                     String             @unique @db.VarChar(255)
  passwordHash              String             @map("password_hash")
  photoUrl                  String?            @map("foto_url")
  bio                       String?            @db.VarChar(500)
  role                      UserRole           @default(user) @map("rol")
  isRider                   Boolean            @default(false) @map("es_rider")
  verified                  Boolean            @default(false) @map("verificado")
  status                    UserStatus         @default(active) @map("estado")
  createdAt                 DateTime           @default(now()) @map("creado_en")
  updatedAt                 DateTime           @updatedAt @map("actualizado_en")
  sessions                  Session[]
  items                     Item[]
  reservations              Reservation[]
  ratingsWritten            Rating[]           @relation("RatingAuthor")
  ratingsReceived           Rating[]           @relation("RatingRated")
  deliveries                Delivery[]         @relation("DeliveryRider")
  cancellations             Cancellation[]
  // Generado con asistencia de IA (Claude) – revisado por Alex Matos, 11/11/2026
  riderApplication          RiderApplication?  @relation("RiderApplicant")
  // Solicitudes de rider que ha resuelto este usuario (si es admin, US-11.03).
  reviewedRiderApplications RiderApplication[] @relation("RiderReviewer")
  // Objetos que ha retirado este usuario (si es admin, US-11.03).
  moderatedItems            ItemModeration[]   @relation("ItemModerator")

  @@map("usuario")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("creada_en")
  expiresAt DateTime  @map("expira_en")
  revokedAt DateTime? @map("revocada_en")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sesion")
}

// Objetos del Sprint 1 (#9, TR-05 #86). Diseño en docs/modelo-datos.md.
// Generado con asistencia de IA (Claude) – revisado por Kai Oliveros, 27/10/2026

enum ItemStatus {
  published @map("publicado")
  paused    @map("pausado")
  withdrawn @map("retirado")

  @@map("estado_objeto")
}

// Las categorías son datos de referencia: las crea la migración, no el seed, para que existan
// también en producción (allí no se ejecuta el seed).
model Category {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique @map("nombre") @db.VarChar(50)
  items Item[]

  @@map("categoria")
}

model Item {
  id                  String          @id @default(uuid()) @db.Uuid
  ownerId             String          @map("propietario_id") @db.Uuid
  categoryId          String          @map("categoria_id") @db.Uuid
  title               String          @map("titulo") @db.VarChar(100)
  description         String          @map("descripcion") @db.VarChar(2000)
  // precio_dia > 0 y fianza >= 0: CHECK en la migración (Prisma no los declara en el esquema).
  dailyPrice          Decimal         @map("precio_dia") @db.Decimal(10, 2)
  deposit             Decimal         @default(0) @map("fianza") @db.Decimal(10, 2)
  neighborhood        String          @map("barrio") @db.VarChar(100)
  // Dirección exacta del propietario (US-05.01, #281): obligatoria si ofrece recogida en su
  // domicilio o rider (lo valida el backend). Nunca sale en la API pública; solo la ve su dueño y,
  // en algunos casos, el arrendatario (ver services/deliveryView.ts).
  address             String?         @map("direccion") @db.VarChar(200)
  // Opcionales: el mapa y la búsqueda por distancia son «si da tiempo» (US-03.04).
  latitude            Decimal?        @map("latitud") @db.Decimal(9, 6)
  longitude           Decimal?        @map("longitud") @db.Decimal(9, 6)
  homeDelivery        Boolean         @default(false) @map("entrega_domicilio")
  riderDelivery       Boolean         @default(false) @map("entrega_rider")
  pickupPointDelivery Boolean         @default(false) @map("entrega_punto_recogida")
  status              ItemStatus      @default(published) @map("estado")
  createdAt           DateTime        @default(now()) @map("creado_en")
  updatedAt           DateTime        @updatedAt @map("actualizado_en")
  // Restrict: no se borra un usuario ni una categoría con objetos (un objeto se «retira», no se borra).
  owner               User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  category            Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  photos              ItemPhoto[]
  reservations        Reservation[]
  // Solo existe si un admin lo retiró (US-11.03).
  moderation          ItemModeration?

  @@index([ownerId])
  @@index([categoryId])
  @@index([status])
  @@map("objeto")
}

// Se guarda la clave del fichero en el bucket, no una URL (ADR 0002).
// orden entre 1 y 5 (máximo 5 fotos por objeto): CHECK en la migración.
model ItemPhoto {
  id     String @id @default(uuid()) @db.Uuid
  itemId String @map("objeto_id") @db.Uuid
  key    String @unique @map("clave")
  order  Int    @map("orden")
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, order])
  @@map("foto_objeto")
}

// Reservas del Sprint 1 (#120, TR-05 #86). Diseño en docs/modelo-datos.md.
// Generado con asistencia de IA (Claude) – revisado por Kai Oliveros, 02/11/2026

enum ReservationStatus {
  pending     @map("pendiente")
  accepted    @map("aceptada")
  rejected    @map("rechazada")
  cancelled   @map("cancelada")
  paid        @map("pagada")
  in_progress @map("en_curso")
  finished    @map("finalizada")
  expired     @map("caducada")

  @@map("estado_reserva")
}

// Estado de la entrega (US-05.02, #288). Con rider: pending → assigned → picked_up → on_the_way →
// delivered. Con domicilio o punto de recogida: pending → delivered («Ya tengo el objeto»).
enum DeliveryStatus {
  pending    @map("pendiente")
  assigned   @map("asignada")
  picked_up  @map("recogida")
  on_the_way @map("en_camino")
  delivered  @map("entregada")

  @@map("estado_entrega")
}

// Generado con asistencia de IA (Claude) – revisado por Alex Matos, 13/11/2026
enum CancellationReason {
  item_withdrawn @map("objeto_retirado")

  @@map("motivo_cancelacion")
}

enum DeliveryMode {
  home         @map("domicilio")
  rider
  pickup_point @map("punto_recogida")

  @@map("modo_entrega")
}

model Reservation {
  id                 String              @id @default(uuid()) @db.Uuid
  itemId             String              @map("objeto_id") @db.Uuid
  renterId           String              @map("arrendatario_id") @db.Uuid
  // Solo fecha, sin hora: el alquiler va por días y no depende de la zona horaria.
  // fecha_fin >= fecha_inicio y precio_total > 0: CHECK en la migración.
  startDate          DateTime            @map("fecha_inicio") @db.Date
  endDate            DateTime            @map("fecha_fin") @db.Date
  totalPrice         Decimal             @map("precio_total") @db.Decimal(10, 2)
  // Opcional en la BD (las reservas anteriores a US-05.01 no lo tienen), pero la API lo exige.
  deliveryMode       DeliveryMode?       @map("modo_entrega")
  delivery           Delivery?
  status             ReservationStatus   @default(pending) @map("estado")
  // Hasta cuándo puede responder el propietario (48 h desde la solicitud, #72). Solo en las pendientes.
  // Por qué se canceló sin que lo pidiera ninguna de las partes (US-11.03); null en el resto.
  cancellationReason CancellationReason? @map("motivo_cancelacion")
  expiresAt          DateTime?           @map("caduca_en")
  createdAt          DateTime            @default(now()) @map("creada_en")
  updatedAt          DateTime            @updatedAt @map("actualizada_en")
  // Restrict: las reservas son el historial de un alquiler; no se borran con su objeto ni su usuario.
  item               Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)
  renter             User                @relation(fields: [renterId], references: [id], onDelete: Restrict)
  payment            Payment?
  ratings            Rating[]
  cancellation       Cancellation?

  @@index([itemId, status])
  @@index([renterId])
  @@map("reserva")
}

// Solicitudes para ser rider del Sprint 2 (#314, US-10.03). Diseño en docs/modelo-datos.md.
// Generado con asistencia de IA (Claude) – revisado por Maxim Nicolau, 11/11/2026

enum RiderVehicle {
  on_foot   @map("a_pie")
  bike      @map("bici")
  scooter   @map("patinete")
  motorbike @map("moto")
  car       @map("coche")

  @@map("vehiculo_rider")
}

enum RiderApplicationStatus {
  pending  @map("pendiente")
  approved @map("aceptada")
  rejected @map("rechazada")

  @@map("estado_solicitud_rider")
}

enum RiderWeekday {
  monday    @map("lunes")
  tuesday   @map("martes")
  wednesday @map("miercoles")
  thursday  @map("jueves")
  friday    @map("viernes")
  saturday  @map("sabado")
  sunday    @map("domingo")

  @@map("dia_semana")
}

// Franjas: mañana 9-14 h, tarde 14-20 h, noche 20-23 h.
enum RiderSlot {
  morning   @map("manana")
  afternoon @map("tarde")
  night     @map("noche")

  @@map("franja_rider")
}

model RiderApplication {
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @unique @map("usuario_id") @db.Uuid
  phone           String                 @map("telefono") @db.VarChar(20)
  zone            String                 @map("zona") @db.VarChar(100)
  vehicle         RiderVehicle           @map("vehiculo")
  // dias y franjas no vacíos: CHECK en la migración (Prisma no los declara en el esquema).
  days            RiderWeekday[]         @map("dias")
  slots           RiderSlot[]            @map("franjas")
  termsAcceptedAt DateTime               @map("condiciones_aceptadas_en")
  status          RiderApplicationStatus @default(pending) @map("estado")
  createdAt       DateTime               @default(now()) @map("creada_en")
  // Revisión del admin (US-11.03, #317). Generado con asistencia de IA (Claude) – revisado por Alex Matos, 11/11/2026
  // Pendiente <=> sin revisor ni fecha; el motivo solo existe si está rechazada (CHECK en la migración).
  reviewedById    String?                @map("revisada_por_id") @db.Uuid
  reviewedAt      DateTime?              @map("revisada_en")
  rejectionReason String?                @map("motivo_rechazo") @db.VarChar(500)
  // Restrict: la solicitud es el historial de la revisión; no se borra con su usuario.
  user            User                   @relation("RiderApplicant", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy      User?                  @relation("RiderReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("solicitud_rider")
}

// Pagos y fianzas (US-07.01, #284). Una reserva tiene como mucho un pago (reserva_id único): la BD
// impide registrar dos pagos de la misma reserva, no cobrarlos (eso lo evita el backend).
// Importe del alquiler (más la entrega): se bloquea al solicitar, se cobra al aceptar y se libera
// si se rechaza, se cancela o caduca (#72).
enum PaymentStatus {
  authorized @map("autorizado")
  paid       @map("pagado")
  released   @map("liberado")
  refunded   @map("reembolsado")

  @@map("estado_pago")
}

// Fianza: «pendiente» hasta el día antes de empezar. Si el alquiler dura hasta 6 días se retiene
// y al final se libera o se ejecuta; si dura más, se cobra y se devuelve (#72).
enum DepositStatus {
  pending   @map("pendiente")
  held      @map("retenida")
  released  @map("liberada")
  charged   @map("ejecutada")
  collected @map("cobrada")
  returned  @map("devuelta")

  @@map("estado_fianza")
}

model Payment {
  id               String         @id @default(uuid()) @db.Uuid
  reservationId    String         @unique @map("reserva_id") @db.Uuid
  // importe_alquiler > 0 y los demás >= 0: CHECK en la migración.
  rentalAmount     Decimal        @map("importe_alquiler") @db.Decimal(10, 2)
  // 0 con recogida y mientras la tabla entrega (US-05.01) no esté en develop.
  deliveryAmount   Decimal        @default(0) @map("importe_entrega") @db.Decimal(10, 2)
  depositAmount    Decimal        @map("importe_fianza") @db.Decimal(10, 2)
  status           PaymentStatus  @default(authorized) @map("estado")
  // null = sin fianza: menos de 0,50 €, el mínimo que Stripe puede retener (CHECK en la migración).
  depositStatus    DepositStatus? @map("estado_fianza")
  // Ids de los PaymentIntent de Stripe (T10). null = sin pasarela (datos de demo).
  rentalReference  String?        @unique @map("referencia_alquiler")
  depositReference String?        @unique @map("referencia_fianza")
  createdAt        DateTime       @default(now()) @map("creado_en")
  updatedAt        DateTime       @updatedAt @map("actualizado_en")
  reservation      Reservation    @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@map("pago")
}

// Entrega de las reservas (US-05.01, #281). Diseño en docs/modelo-datos.md.
// Generado con asistencia de IA (Claude) – revisado por Alex Matos, 11/11/2026

// Datos de referencia: lugares públicos que crea la migración, como las categorías.
model PickupPoint {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @map("nombre") @db.VarChar(100)
  address      String     @map("direccion") @db.VarChar(200)
  neighborhood String     @map("barrio") @db.VarChar(100)
  latitude     Decimal    @map("latitud") @db.Decimal(9, 6)
  longitude    Decimal    @map("longitud") @db.Decimal(9, 6)
  deliveries   Delivery[]

  @@map("punto_recogida")
}

// Una entrega por reserva. tarifa > 0 cuando no es NULL: CHECK en la migración.
model Delivery {
  id                   String         @id @default(uuid()) @db.Uuid
  reservationId        String         @unique @map("reserva_id") @db.Uuid
  pickupPointId        String?        @map("punto_recogida_id") @db.Uuid
  // «HH:MM-HH:MM». NULL = «Lo antes posible»; solo tiene sentido con rider.
  slot                 String?        @map("franja") @db.VarChar(11)
  deliveryAddress      String?        @map("direccion_destino") @db.VarChar(200)
  deliveryNeighborhood String?        @map("barrio_destino") @db.VarChar(100)
  // Tarifa del rider, calculada por el servidor. El importe del alquiler sigue en reserva.precio_total.
  fee                  Decimal?       @map("tarifa") @db.Decimal(10, 2)
  // Seguimiento (US-05.02, #288). Cada estado guarda su fecha y hora; no se puede saltar ni volver atrás.
  status               DeliveryStatus @default(pending) @map("estado")
  // Quién reparte: lo rellena US-10.01 (#292) al aceptar el trabajo. null sin rider.
  riderId              String?        @map("rider_id") @db.Uuid
  // 6 cifras de un solo uso, solo con rider. Solo lo ve el arrendatario. Se bloquea tras 5 intentos.
  deliveryCode         String?        @map("codigo_entrega") @db.Char(6)
  codeAttempts         Int            @default(0) @map("intentos_codigo") @db.SmallInt
  assignedAt           DateTime?      @map("asignada_en")
  pickedUpAt           DateTime?      @map("recogida_en")
  onTheWayAt           DateTime?      @map("en_camino_en")
  deliveredAt          DateTime?      @map("entregada_en")
  // «He devuelto el objeto»: la reserva pasa a «Finalizada».
  returnedAt           DateTime?      @map("devuelta_en")
  createdAt            DateTime       @default(now()) @map("creada_en")
  // Restrict: las reservas son historial y no se borran; un punto de recogida en uso tampoco.
  reservation          Reservation    @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  pickupPoint          PickupPoint?   @relation(fields: [pickupPointId], references: [id], onDelete: Restrict)
  rider                User?          @relation("DeliveryRider", fields: [riderId], references: [id], onDelete: Restrict)

  @@index([pickupPointId])
  @@index([riderId])
  @@map("entrega")
}

// Valoraciones (US-08.01, #295; US-08.02, #298). Diseño en docs/modelo-datos.md.
enum RatingType {
  rental @map("alquiler") // el arrendatario valora el alquiler (T20)
  user   @map("usuario") // el propietario valora al arrendatario (T23)

  @@map("tipo_valoracion")
}

model Rating {
  id            String      @id @default(uuid()) @db.Uuid
  reservationId String      @map("reserva_id") @db.Uuid
  authorId      String      @map("autor_id") @db.Uuid
  ratedUserId   String      @map("valorado_id") @db.Uuid
  type          RatingType  @map("tipo")
  // puntuacion entre 1 y 5 y autor distinto del valorado: CHECK en la migración.
  score         Int         @map("puntuacion") @db.SmallInt
  comment       String?     @map("comentario") @db.VarChar(1000)
  createdAt     DateTime    @default(now()) @map("creada_en")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  author        User        @relation("RatingAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  ratedUser     User        @relation("RatingRated", fields: [ratedUserId], references: [id], onDelete: Restrict)

  // Una valoración por alquiler y autor: el arrendatario una y el propietario otra.
  @@unique([reservationId, authorId])
  @@index([ratedUserId])
  @@map("valoracion")
}

// Retirada de un objeto por un admin (US-11.03, #317). Diseño en docs/modelo-datos.md.
// Generado con asistencia de IA (Claude) – revisado por Alex Matos, 13/11/2026

enum WithdrawalReason {
  scam       @map("posible_estafa")
  prohibited @map("prohibido")
  misleading @map("enganoso")
  other      @map("otro")

  @@map("motivo_retirada")
}

// Una fila por objeto retirado por un admin; los retirados por su dueño no la tienen.
// Con motivo «otro», los detalles son obligatorios: CHECK en la migración.
model ItemModeration {
  id          String           @id @default(uuid()) @db.Uuid
  itemId      String           @unique @map("objeto_id") @db.Uuid
  adminId     String           @map("admin_id") @db.Uuid
  reason      WithdrawalReason @map("motivo")
  details     String?          @map("detalles") @db.VarChar(500)
  withdrawnAt DateTime         @default(now()) @map("retirado_en")
  // Restrict: es el historial de la moderación; no se borra con su objeto ni con su admin.
  item        Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  admin       User             @relation("ItemModerator", fields: [adminId], references: [id], onDelete: Restrict)

  @@map("retirada_objeto")
}

// Cancelación de una reserva (US-04.05, #308): quién la canceló, cuándo y qué penalización y
// reembolso se aplicaron. Una fila por reserva cancelada (reserva_id único), en una tabla aparte
// para no tocar `reserva`, que también modifican otras historias del sprint.
// porcentaje IN (0, 35, 100), penalizacion >= 0 y reembolso >= 0: CHECK en la migración.
// Generado con asistencia de IA (Claude) – revisado por Alex Matos, 17/11/2026
model Cancellation {
  id             String      @id @default(uuid()) @db.Uuid
  reservationId  String      @unique @map("reserva_id") @db.Uuid
  cancelledById  String      @map("cancelada_por") @db.Uuid
  cancelledAt    DateTime    @default(now()) @map("cancelada_en")
  // Penalización (% del precio del alquiler) por los días que faltaban para el inicio.
  penaltyPercent Int         @map("porcentaje")
  // La recibe la otra persona. Si cancela el propietario solo se registra, no se cobra.
  penaltyAmount  Decimal     @map("penalizacion") @db.Decimal(10, 2)
  // Lo que se devolvió al arrendatario (alquiler y entrega, menos la penalización si cancela él).
  refundAmount   Decimal     @map("reembolso") @db.Decimal(10, 2)
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  cancelledBy    User        @relation(fields: [cancelledById], references: [id], onDelete: Restrict)

  @@index([cancelledById])
  @@map("cancelacion")
}
