generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Tablas y columnas en español según docs/modelo-datos.md (#98); modelos y campos en inglés.

enum UserRole {
  user  @map("usuario")
  admin

  @@map("rol_usuario")
}

enum UserStatus {
  active  @map("activo")
  blocked @map("bloqueado")

  @@map("estado_usuario")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  username     String        @unique @map("nombre_usuario") @db.VarChar(30)
  email        String        @unique @db.VarChar(255)
  passwordHash String        @map("password_hash")
  photoUrl     String?       @map("foto_url")
  bio          String?       @db.VarChar(500)
  role         UserRole      @default(user) @map("rol")
  isRider      Boolean       @default(false) @map("es_rider")
  verified     Boolean       @default(false) @map("verificado")
  status       UserStatus    @default(active) @map("estado")
  createdAt    DateTime      @default(now()) @map("creado_en")
  updatedAt    DateTime      @updatedAt @map("actualizado_en")
  sessions     Session[]
  items        Item[]
  reservations Reservation[]

  @@map("usuario")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("creada_en")
  expiresAt DateTime  @map("expira_en")
  revokedAt DateTime? @map("revocada_en")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sesion")
}

// Objetos del Sprint 1 (#9, TR-05 #86). Diseño en docs/modelo-datos.md.
// Generado con asistencia de IA (Claude) – revisado por Kai Oliveros, 27/10/2026

enum ItemStatus {
  published @map("publicado")
  paused    @map("pausado")
  withdrawn @map("retirado")

  @@map("estado_objeto")
}

// Las categorías son datos de referencia: las crea la migración, no el seed, para que existan
// también en producción (allí no se ejecuta el seed).
model Category {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique @map("nombre") @db.VarChar(50)
  items Item[]

  @@map("categoria")
}

model Item {
  id                  String        @id @default(uuid()) @db.Uuid
  ownerId             String        @map("propietario_id") @db.Uuid
  categoryId          String        @map("categoria_id") @db.Uuid
  title               String        @map("titulo") @db.VarChar(100)
  description         String        @map("descripcion") @db.VarChar(2000)
  // precio_dia > 0 y fianza >= 0: CHECK en la migración (Prisma no los declara en el esquema).
  dailyPrice          Decimal       @map("precio_dia") @db.Decimal(10, 2)
  deposit             Decimal       @default(0) @map("fianza") @db.Decimal(10, 2)
  neighborhood        String        @map("barrio") @db.VarChar(100)
  // Opcionales: el mapa y la búsqueda por distancia son «si da tiempo» (US-03.04).
  latitude            Decimal?      @map("latitud") @db.Decimal(9, 6)
  longitude           Decimal?      @map("longitud") @db.Decimal(9, 6)
  homeDelivery        Boolean       @default(false) @map("entrega_domicilio")
  riderDelivery       Boolean       @default(false) @map("entrega_rider")
  pickupPointDelivery Boolean       @default(false) @map("entrega_punto_recogida")
  status              ItemStatus    @default(published) @map("estado")
  createdAt           DateTime      @default(now()) @map("creado_en")
  updatedAt           DateTime      @updatedAt @map("actualizado_en")
  // Restrict: no se borra un usuario ni una categoría con objetos (un objeto se «retira», no se borra).
  owner               User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  category            Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  photos              ItemPhoto[]
  reservations        Reservation[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([status])
  @@map("objeto")
}

// Se guarda la clave del fichero en el bucket, no una URL (ADR 0002).
// orden entre 1 y 5 (máximo 5 fotos por objeto): CHECK en la migración.
model ItemPhoto {
  id     String @id @default(uuid()) @db.Uuid
  itemId String @map("objeto_id") @db.Uuid
  key    String @unique @map("clave")
  order  Int    @map("orden")
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, order])
  @@map("foto_objeto")
}

// Reservas del Sprint 1 (#120, TR-05 #86). Diseño en docs/modelo-datos.md.
// Generado con asistencia de IA (Claude) – revisado por Kai Oliveros, 02/11/2026

enum ReservationStatus {
  pending     @map("pendiente")
  accepted    @map("aceptada")
  rejected    @map("rechazada")
  cancelled   @map("cancelada")
  paid        @map("pagada")
  in_progress @map("en_curso")
  finished    @map("finalizada")

  @@map("estado_reserva")
}

enum DeliveryMode {
  home         @map("domicilio")
  rider
  pickup_point @map("punto_recogida")

  @@map("modo_entrega")
}

model Reservation {
  id           String            @id @default(uuid()) @db.Uuid
  itemId       String            @map("objeto_id") @db.Uuid
  renterId     String            @map("arrendatario_id") @db.Uuid
  // Solo fecha, sin hora: el alquiler va por días y no depende de la zona horaria.
  // fecha_fin >= fecha_inicio y precio_total > 0: CHECK en la migración.
  startDate    DateTime          @map("fecha_inicio") @db.Date
  endDate      DateTime          @map("fecha_fin") @db.Date
  totalPrice   Decimal           @map("precio_total") @db.Decimal(10, 2)
  // Opcional: el modo de entrega se elige en US-05.01 (Sprint 2).
  deliveryMode DeliveryMode?     @map("modo_entrega")
  status       ReservationStatus @default(pending) @map("estado")
  createdAt    DateTime          @default(now()) @map("creada_en")
  updatedAt    DateTime          @updatedAt @map("actualizada_en")
  // Restrict: las reservas son el historial de un alquiler; no se borran con su objeto ni su usuario.
  item         Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  renter       User              @relation(fields: [renterId], references: [id], onDelete: Restrict)
  payment      Payment?

  @@index([itemId, status])
  @@index([renterId])
  @@map("reserva")
}

// Pagos y fianzas (US-07.01, #284). Una reserva tiene como mucho un pago (reserva_id único):
// así la BD impide pagar dos veces la misma reserva.
enum PaymentStatus {
  pending  @map("pendiente")
  paid     @map("pagado")
  rejected @map("rechazado")
  refunded @map("reembolsado")

  @@map("estado_pago")
}

enum DepositStatus {
  held     @map("retenida")
  released @map("liberada")
  charged  @map("ejecutada")

  @@map("estado_fianza")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  reservationId    String        @unique @map("reserva_id") @db.Uuid
  // importes >= 0: CHECK en la migración.
  rentalAmount     Decimal       @map("importe_alquiler") @db.Decimal(10, 2)
  // 0 hasta que exista la tabla entrega (US-05.01, T6).
  deliveryAmount   Decimal       @default(0) @map("importe_entrega") @db.Decimal(10, 2)
  depositAmount    Decimal       @map("importe_fianza") @db.Decimal(10, 2)
  status           PaymentStatus @default(pending) @map("estado")
  depositStatus    DepositStatus @default(held) @map("estado_fianza")
  // Id del PaymentIntent de Stripe (T10).
  gatewayReference String?       @map("referencia_pasarela")
  createdAt        DateTime      @default(now()) @map("creado_en")
  reservation      Reservation   @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@map("pago")
}
