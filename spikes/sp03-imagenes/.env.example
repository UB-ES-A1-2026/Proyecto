# Por defecto el prototipo usa el S3 local (S3Mock). Para probar contra un proveedor real, copia este
# fichero a .env y rellena los valores. Nunca subas el .env al repo (el repo es público).

# S3 local (docker compose up -d)
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=rentit-fotos
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_FORCE_PATH_STYLE=true

# Supabase Storage (API compatible con S3): Project Settings → Storage → S3 Connection
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=<región del proyecto, p. ej. eu-west-3>
# S3_FORCE_PATH_STYLE=true

# AWS S3
# S3_ENDPOINT=            (vacío: el SDK usa el endpoint de AWS)
# S3_REGION=eu-west-3
# S3_FORCE_PATH_STYLE=false
